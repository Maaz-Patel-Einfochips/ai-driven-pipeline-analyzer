pipeline {
    agent any

    environment {
        // 👇 Store your Jenkins credentials in Jenkins Credentials Manager
        // Example: ID = "jenkins-api-creds"
        JENKINS_URL = 'http://localhost:8080'   // Update with your Jenkins URL
    }

    stages {
        stage('Fetch Jobs') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: 'jenkins-api-creds',
                                                     usernameVariable: 'USERNAME',
                                                     passwordVariable: 'PASSWORD')]) {
                        // Call Jenkins REST API
                        def jobsJson = sh(
                            script: """
                                curl -s -u ${USERNAME}:${PASSWORD} ${JENKINS_URL}/api/json?tree=jobs[name]
                            """,
                            returnStdout: true
                        ).trim()

                        // Parse JSON
                        def jobs = readJSON text: jobsJson

                        echo "✅ Available jobs: ${jobs.jobs*.name}"

                        // Save job list for later stages (optional)
                        env.ALL_JOBS = jobs.jobs*.name.join(',')
                    }
                }
            }
        }

        stage('Select Job (Example)') {
            steps {
                script {
                    def allJobs = env.ALL_JOBS?.split(',') ?: []
                    echo "User could select from: ${allJobs}"
                    // Here you could add logic to filter or choose one job dynamically
                }
            }
        }
    }
}
