@NonCPS
def getAllJobNames() {
    return Jenkins.instance.getAllItems(Job.class).collect { it.fullName }
}

pipeline {
    agent any
    stages {
        stage('Fetch Jobs') {
            steps {
                script {
                    def jobs = getAllJobNames()
                    echo "✅ Available jobs: ${jobs}"
                }
            }
        }
    }
}
