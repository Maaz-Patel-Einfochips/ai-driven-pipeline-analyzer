@Library('jenkins-shared-lib@jenkinsfile-enhancement') _   // Load shared library

pipeline {
    agent any

    stages {
        stage('Fetch Jobs from Shared Library') {
            steps {
                script {
                    def jobs = jobUtils.listJobs()
                    echo "✅ Available jobs: ${jobs}"
                }
            }
        }

        stage('Select Job') {
            steps {
                script {
                    def jobs = jobUtils.listJobs()
                    if (jobs.isEmpty()) {
                        error "❌ No jobs found!"
                    }

                    // Pause and ask user which job to pick
                    def selectedJob = input(
                        message: 'Select a job to fetch its config.xml:',
                        parameters: [
                            choice(
                                name: 'TARGET_JOB',
                                choices: jobs,
                                description: 'Choose a Jenkins job'
                            )
                        ]
                    )

                    env.TARGET_JOB = selectedJob
                    echo "✅ You selected: ${env.TARGET_JOB}"
                }
            }
        }

        stage('Fetch Job Config') {
            steps {
                script {
                    def configXml = jobUtils.getJobConfig(env.TARGET_JOB)

                    if (configXml) {
                        echo "📄 Config of ${env.TARGET_JOB}:\n${configXml.take(500)}..."
                        // Optionally save it as a file and archive it
                        writeFile file: "${env.TARGET_JOB}-config.xml", text: configXml
                        archiveArtifacts artifacts: "${env.TARGET_JOB}-config.xml", fingerprint: true
                    } else {
                        echo "❌ No config found for ${env.TARGET_JOB}"
                    }
                }
            }
        }
    }
}