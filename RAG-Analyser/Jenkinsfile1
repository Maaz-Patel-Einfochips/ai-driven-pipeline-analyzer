@Library('jenkins-shared-lib@jenkinsfile-enhancement') _   // Load shared library

pipeline {
    agent any

    stages {
        stage('Fetch Jobs from Shared Library') {
            steps {
                script {
                    def jobs = jobUtils.listJobs()
                    echo "✅ Available jobs: ${jobs}"
                }
            }
        }

        stage('Fetch Job Config') {
            steps {
                script {
                    // Pick the first job for demo
                    def jobName = jobUtils.listJobs()[0]
                    def configXml = jobUtils.getJobConfig(jobName)

                    if (configXml) {
                        echo "📄 Config of ${jobName}:\n${configXml.take(500)}..." // show first 500 chars
                    } else {
                        echo "❌ No config found for ${jobName}"
                    }
                }
            }
        }
    }
}
