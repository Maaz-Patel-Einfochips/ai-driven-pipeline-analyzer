pipeline {
    agent any

    environment {
        JENKINS_URL = 'http://jenkins-controller:8080'  // replace with actual controller URL
    }

    stages {
        stage('Fetch Jobs') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: 'jenkins-api-creds',
                                                     usernameVariable: 'USERNAME',
                                                     passwordVariable: 'APITOKEN')]) {
                        def jobsJson = sh(
                            script: """curl -s -u $USERNAME:$APITOKEN $JENKINS_URL/api/json?tree=jobs[name]""",
                            returnStdout: true
                        ).trim()

                        if (!jobsJson) {
                            error("❌ Failed to fetch jobs from Jenkins API. Check URL & credentials.")
                        }

                        def jobs = readJSON text: jobsJson
                        echo "✅ Available jobs: ${jobs.jobs*.name}"
                        env.ALL_JOBS = jobs.jobs*.name.join(',')
                    }
                }
            }
        }

        stage('Select Job (Example)') {
            steps {
                script {
                    def allJobs = env.ALL_JOBS?.split(',') ?: []
                    echo "Available for selection: ${allJobs}"
                }
            }
        }
    }
}
